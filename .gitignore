# Explicit publication allowlist. Private references, player data and build trees stay local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/VERSION
!/CHANGELOG.md
!/requirements.txt
!/releases/
!/releases/**
!/docs/
!/docs/**
!/server/
!/server/*.py
!/tools/
!/tools/*.py
!/tools/*.cjs
!/tools/*.sh
!/test/
!/test/*.py
!/test/*.mjs
!/client/
/client/*
!/client/*.js
!/client/*.css
!/client/*.html
!/client/pwa/
!/client/pwa/**
!/client/assets/
/client/assets/*
!/client/assets/panel.png
!/client/assets/panel.json
!/client/assets/worker.png
!/client/assets/worker.json
!/client/assets/grass-v2.webp
!/client/assets/asphalt-v2.webp
!/client/assets/dirt-v2.webp
!/client/assets/paving.png
!/client/assets/birch.png
!/art/
/art/*
!/art/ART-DIRECTION.md
!/art/production/
/art/production/*
!/art/production/*.py
!/art/production/*.sh
!/art/production/*.md
!/art/production/*.json
!/art/models/
/art/models/*
!/art/models/panel-v3.blend
!/art/models/worker-v3.blend
!/art/models/birch-v1.blend
!/art/concepts/
/art/concepts/*
!/art/concepts/town-v2.png
!/art/concepts/worker-v1.png
!/art/textures/
/art/textures/*
!/art/textures/ground-v2/
!/art/textures/ground-v2/**
!/art/vendor/
!/art/vendor/**
!/.agent-skills/
!/.agent-skills/**
# Defense in depth, even inside allowed directories.
**/__pycache__/
**/node_modules/
**/.git/
*.pyc
*.sqlite
*.sqlite-*
*.db
*.db-*
*.env
.env*
*.pem
*.key
*.p12
*.zip
*.tar*
*.blend1
*.log
